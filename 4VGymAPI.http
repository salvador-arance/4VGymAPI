@_4VGymAPI_HostAddress = http://localhost:5117

# Antes de lanzar estas peticiones carga los datos de prueba con Sql/datos.sql
# (ver README). Los POST correctos insertan en la BBDD, así que para repetir
# las pruebas desde cero vuelve a crear la BBDD y a ejecutar el script.

########################################################################
# TIPOS DE ACTIVIDAD
########################################################################

### Listado de tipos de actividad (200)
GET {{_4VGymAPI_HostAddress}}/activity-types
Accept: application/json

### Happy path: Zumba con 3 monitores (201)
POST {{_4VGymAPI_HostAddress}}/activity-types
Content-Type: application/json

{
  "name": "Zumba",
  "number-monitors": 3
}

### Happy path: sin número de monitores, se da por supuesto que es 1 (201)
POST {{_4VGymAPI_HostAddress}}/activity-types
Content-Type: application/json

{
  "name": "Yoga"
}

### Error 4: JSON vacío (sin nombre)
POST {{_4VGymAPI_HostAddress}}/activity-types
Content-Type: application/json

{
}

### Error 4: nombre vacío
POST {{_4VGymAPI_HostAddress}}/activity-types
Content-Type: application/json

{
  "name": "",
  "number-monitors": 3
}

### Error 5: número de monitores menor que 1
POST {{_4VGymAPI_HostAddress}}/activity-types
Content-Type: application/json

{
  "name": "Boxeo",
  "number-monitors": 0
}

### Error 6: nombre repetido (sin distinguir mayúsculas)
POST {{_4VGymAPI_HostAddress}}/activity-types
Content-Type: application/json

{
  "name": "pilates",
  "number-monitors": 1
}

########################################################################
# MONITORES
########################################################################

### Listado de todos los monitores (200)
GET {{_4VGymAPI_HostAddress}}/instructors
Accept: application/json

### Monitores cuyo nombre empieza por M (200)
GET {{_4VGymAPI_HostAddress}}/instructors?first_initial=M
Accept: application/json

### Filtro sin coincidencias: lista vacía (200)
GET {{_4VGymAPI_HostAddress}}/instructors?first_initial=Z
Accept: application/json

### Monitor por id (200)
GET {{_4VGymAPI_HostAddress}}/instructors/2
Accept: application/json

### Monitor inexistente (400, código 2)
GET {{_4VGymAPI_HostAddress}}/instructors/99
Accept: application/json

### Happy path: nuevo monitor (201)
POST {{_4VGymAPI_HostAddress}}/instructors
Content-Type: application/json

{
  "name": "David Noya",
  "phone": "666554433",
  "email": "david_noya@cuatrovientos.org",
  "photo_url": "http://www.davidnoya.com/david_noya.jpg"
}

### Error 11: sin nombre
POST {{_4VGymAPI_HostAddress}}/instructors
Content-Type: application/json

{
  "phone": "666554433",
  "email": "sin_nombre@example.com",
  "photo_url": "https://example.com/x.jpg"
}

### Error 12: sin email
POST {{_4VGymAPI_HostAddress}}/instructors
Content-Type: application/json

{
  "name": "Pedro Sanz",
  "phone": "666554433",
  "photo_url": "https://example.com/x.jpg"
}

### Error 13: email con formato incorrecto
POST {{_4VGymAPI_HostAddress}}/instructors
Content-Type: application/json

{
  "name": "Pedro Sanz",
  "phone": "666554433",
  "email": "pedro_sanz.cuatrovientos.org",
  "photo_url": "https://example.com/x.jpg"
}

### Error 14: teléfono obligatorio
POST {{_4VGymAPI_HostAddress}}/instructors
Content-Type: application/json

{
  "name": "Pedro Sanz",
  "email": "pedro_sanz@cuatrovientos.org",
  "photo_url": "https://example.com/x.jpg"
}

### Error 15: teléfono con formato incorrecto
POST {{_4VGymAPI_HostAddress}}/instructors
Content-Type: application/json

{
  "name": "Pedro Sanz",
  "phone": "adsadsa",
  "email": "pedro_sanz@cuatrovientos.org",
  "photo_url": "https://example.com/x.jpg"
}

### Error 16: la foto no es una URL
POST {{_4VGymAPI_HostAddress}}/instructors
Content-Type: application/json

{
  "name": "Pedro Sanz",
  "phone": "666554433",
  "email": "pedro_sanz@cuatrovientos.org",
  "photo_url": "pedro_sanz.jpg"
}

### Error 17: ya existe un monitor con el mismo email y nombre (sin distinguir mayúsculas)
POST {{_4VGymAPI_HostAddress}}/instructors
Content-Type: application/json

{
  "name": "ANA GARCÍA",
  "phone": "+34600111222",
  "email": "Ana@Example.com",
  "photo_url": "https://example.com/ana.jpg"
}

########################################################################
# ACTIVIDADES
########################################################################

### Happy path: BodyPump con los monitores 4 y 5 (201)
POST {{_4VGymAPI_HostAddress}}/activities
Content-Type: application/json

{
  "activity_type_id": 1,
  "instructors_id": [4, 5],
  "max_participants": 20,
  "date_start": "2030-02-01T10:00:00",
  "date_end": "2030-02-01T11:00:00"
}

### Error 39: Ana (1) ya tiene BodyPump el 15/01 de 10:00 a 11:00
POST {{_4VGymAPI_HostAddress}}/activities
Content-Type: application/json

{
  "activity_type_id": 2,
  "instructors_id": [1],
  "max_participants": 15,
  "date_start": "2030-01-15T10:30:00",
  "date_end": "2030-01-15T11:30:00"
}

### Happy path: Ana justo después de BodyPump, sin solaparse (201)
POST {{_4VGymAPI_HostAddress}}/activities
Content-Type: application/json

{
  "activity_type_id": 2,
  "instructors_id": [1],
  "max_participants": 15,
  "date_start": "2030-01-15T11:00:00",
  "date_end": "2030-01-15T12:00:00"
}

### Error 34: el tipo de actividad no existe
POST {{_4VGymAPI_HostAddress}}/activities
Content-Type: application/json

{
  "activity_type_id": 99,
  "instructors_id": [2],
  "max_participants": 20,
  "date_start": "2030-03-01T10:00:00",
  "date_end": "2030-03-01T11:00:00"
}

### Error 35 (dos veces): los monitores no existen
POST {{_4VGymAPI_HostAddress}}/activities
Content-Type: application/json

{
  "activity_type_id": 2,
  "instructors_id": [98, 99],
  "max_participants": 20,
  "date_start": "2030-03-01T10:00:00",
  "date_end": "2030-03-01T11:00:00"
}

### Error 38: CrossFit necesita al menos 3 monitores
POST {{_4VGymAPI_HostAddress}}/activities
Content-Type: application/json

{
  "activity_type_id": 4,
  "instructors_id": [2],
  "max_participants": 20,
  "date_start": "2030-03-01T10:00:00",
  "date_end": "2030-03-01T11:00:00"
}

### Error 40: monitores repetidos
POST {{_4VGymAPI_HostAddress}}/activities
Content-Type: application/json

{
  "activity_type_id": 2,
  "instructors_id": [2, 2],
  "max_participants": 20,
  "date_start": "2030-03-01T10:00:00",
  "date_end": "2030-03-01T11:00:00"
}

### Errores 34, 35 y 40 a la vez (el repositorio acumula todos los errores)
POST {{_4VGymAPI_HostAddress}}/activities
Content-Type: application/json

{
  "activity_type_id": 99,
  "instructors_id": [99, 99],
  "max_participants": 20,
  "date_start": "2030-03-01T10:00:00",
  "date_end": "2030-03-01T11:00:00"
}

### Errores 36 y 37: fecha de fin anterior a la de inicio y fechas en el pasado (validadores propios)
POST {{_4VGymAPI_HostAddress}}/activities
Content-Type: application/json

{
  "activity_type_id": 2,
  "instructors_id": [2],
  "max_participants": 20,
  "date_start": "2025-10-21T11:05:48",
  "date_end": "2024-10-21T12:05:48"
}

### Error 25: aforo fuera de rango (DataAnnotations)
POST {{_4VGymAPI_HostAddress}}/activities
Content-Type: application/json

{
  "activity_type_id": 2,
  "instructors_id": [2],
  "max_participants": 30,
  "date_start": "2030-03-01T10:00:00",
  "date_end": "2030-03-01T11:00:00"
}

### Error 26: lista de monitores nula (DataAnnotations)
POST {{_4VGymAPI_HostAddress}}/activities
Content-Type: application/json

{
  "activity_type_id": 2,
  "instructors_id": null,
  "max_participants": 20,
  "date_start": "2030-03-01T10:00:00",
  "date_end": "2030-03-01T11:00:00"
}

### Errores 27, 28, 29 y 30: sin monitores, sin fechas y sin tipo (DataAnnotations)
POST {{_4VGymAPI_HostAddress}}/activities
Content-Type: application/json

{
  "instructors_id": [],
  "max_participants": 20
}