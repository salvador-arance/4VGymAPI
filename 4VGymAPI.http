@_4VGymAPI_HostAddress = http://localhost:5117

### ===================== TIPOS DE ACTIVIDAD =====================

### Listar tipos de actividad (200)
GET {{_4VGymAPI_HostAddress}}/activity-types
Accept: application/json

### Crear tipo de actividad (201)
POST {{_4VGymAPI_HostAddress}}/activity-types
Content-Type: application/json

{
  "name": "Zumba",
  "number-monitors": 3
}

### Crear tipo de actividad sin número de monitores, se pone 1 (201)
POST {{_4VGymAPI_HostAddress}}/activity-types
Content-Type: application/json

{
  "name": "Yoga"
}

### Error 4: sin nombre (400)
POST {{_4VGymAPI_HostAddress}}/activity-types
Content-Type: application/json

{
  "name": null
}

### Error 5: menos de 1 monitor (400)
POST {{_4VGymAPI_HostAddress}}/activity-types
Content-Type: application/json

{
  "name": "Boxeo",
  "number-monitors": 0
}

### Error 6: nombre repetido (400)
POST {{_4VGymAPI_HostAddress}}/activity-types
Content-Type: application/json

{
  "name": "pilates",
  "number-monitors": 1
}

### ===================== MONITORES =====================

### Listar todos los monitores (200)
GET {{_4VGymAPI_HostAddress}}/instructors
Accept: application/json

### Filtrar por inicial (200)
GET {{_4VGymAPI_HostAddress}}/instructors?first_initial=M
Accept: application/json

### Filtrar por inicial sin coincidencias, lista vacía (200)
GET {{_4VGymAPI_HostAddress}}/instructors?first_initial=Z
Accept: application/json

### Monitor por ID (200)
GET {{_4VGymAPI_HostAddress}}/instructors/1
Accept: application/json

### Monitor por ID que no existe (400)
GET {{_4VGymAPI_HostAddress}}/instructors/999
Accept: application/json

### Crear monitor (201)
POST {{_4VGymAPI_HostAddress}}/instructors
Content-Type: application/json

{
  "name": "Laura Sanz",
  "email": "laura@example.com",
  "photo_url": "https://example.com/laura.jpg",
  "phone": "+34600999000"
}

### Error 11: sin nombre (400)
POST {{_4VGymAPI_HostAddress}}/instructors
Content-Type: application/json

{
  "email": "sinnombre@example.com",
  "photo_url": "https://example.com/x.jpg",
  "phone": "+34600999001"
}

### Error 12: sin email (400)
POST {{_4VGymAPI_HostAddress}}/instructors
Content-Type: application/json

{
  "name": "Sin Email",
  "photo_url": "https://example.com/x.jpg",
  "phone": "+34600999002"
}

